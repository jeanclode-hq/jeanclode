{
  "_doc": "Shared by backend/tests/routers/test_thirdparty_plugin_contract.py and cli/tests/test_thirdparty_plugin_contract.py. The backend reads `source` from `repos` and must emit exactly `spec`; the CLI clones `spec` from the same `repos` and must load exactly `skills`. A file value of {\"skill\": name} is a SKILL.md with that frontmatter name. A repo key is its URL, with @ref when the files live at that ref rather than the default branch.",
  "cases": [
    {
      "id": "shared-source-skills-allowlist",
      "source": "https://gitlab.example.org/acme/team-skills",
      "install": "framework",
      "repos": {
        "https://gitlab.example.org/acme/team-skills": {
          ".claude-plugin/marketplace.json": {
            "name": "acme-skills",
            "plugins": [
              {"name": "framework", "source": "./", "strict": false, "skills": ["./skills/framework"]},
              {"name": "infrastructure", "source": "./", "strict": false, "skills": ["./skills/helm"]}
            ]
          },
          "skills/framework/SKILL.md": {"skill": "framework"},
          "skills/helm/SKILL.md": {"skill": "helm"}
        }
      },
      "spec": {
        "git_url": "https://gitlab.example.org/acme/team-skills",
        "display_name": "framework",
        "skills": ["./skills/framework"]
      },
      "skills": ["framework"]
    },
    {
      "id": "url-source-pinned-to-a-tag",
      "source": "https://gitlab.example.org/acme/team-skills",
      "install": "framework",
      "repos": {
        "https://gitlab.example.org/acme/team-skills": {
          ".claude-plugin/marketplace.json": {
            "name": "acme-skills",
            "plugins": [
              {
                "name": "framework",
                "source": {"source": "url", "url": "https://gitlab.example.org/platform-team/framework.git", "ref": "6.47.1"},
                "strict": false,
                "skills": ["./.claude/skills/framework"]
              }
            ]
          }
        },
        "https://gitlab.example.org/platform-team/framework@6.47.1": {
          ".claude/skills/framework/SKILL.md": {"skill": "framework"},
          "framework/__init__.py": ""
        }
      },
      "spec": {
        "git_url": "https://gitlab.example.org/platform-team/framework.git",
        "ref": "6.47.1",
        "display_name": "framework",
        "skills": ["./.claude/skills/framework"]
      },
      "skills": ["framework"]
    },
    {
