# Jeanclode Environment Configuration
# Copy this to .env and customize for your setup
#
# Quick Start (minimal config):
#   1. cp .env.example .env
#   2. Set database, redis, encryption, and admin secrets below
#   3. Run: docker compose --profile all up -d
#   4. Open http://localhost:3000/admin — the admin page will guide you
#      through configuring GitHub / GitLab / LLM credentials.

# ==================== REQUIRED ====================

# --- Database ---
POSTGRES_DB=jeanclode
POSTGRES_USER=jeanclode
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://jeanclode:CHANGE_ME_STRONG_PASSWORD@postgres:5432/jeanclode

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Encryption key for DB-stored secrets ---
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=change-me-generate-a-real-key

# --- Admin secret (gates the /admin page) ---
# Must be at least 32 characters.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=change-me-generate-a-32-char-secret

# --- OAuth state signing key ---
# Signs the short-lived cookie that carries PKCE state between the OAuth
# authorize redirect and the callback. Must be the same value on every
# backend pod, otherwise logins that hit a different pod on callback fail.
# Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=change-me-generate-a-32-char-secret

# --- URLs ---
FRONTEND_URL=http://localhost:3000

# --- This backend's own URL, reachable from sandboxed agent containers ---
# Used for container-initiated calls back to this backend (agent memory).
# Defaults to http://backend:8000 (the compose service DNS name) — only
# needed if BACKEND_PORT or your domain changes.
# BACKEND_URL=http://backend:8000

# ==================== Ports (optional) ====================
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Browser-facing backend URL baked into the frontend at runtime.
# Only needed if BACKEND_PORT or your domain changes — defaults to http://localhost:8000.
# NUXT_PUBLIC_API_BASE=http://localhost:8000

# SSR-only backend URL for the frontend container (its own localhost is not the
# backend). Defaults to the compose service name http://backend:8000.
# NUXT_API_INTERNAL=http://backend:8000

# ==================== OPTIONAL: Provider config via env ====================
# By default, git provider and LLM credentials are configured through the
# /admin page and stored encrypted in the database. You can instead set
# them via env vars below — env vars take precedence over DB config.

# --- GitHub ---
# GITHUB_ENABLED=true
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# GITHUB_APP_ID=your-github-app-id
# GITHUB_APP_NAME=jeanclode
# GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# GITHUB_APP_PRIVATE_KEY_PATH=./certs/github-app-private-key.pem

# --- GitLab ---
# GITLAB_ENABLED=true
# GITLAB_CLIENT_ID=your-gitlab-client-id
# GITLAB_CLIENT_SECRET=your-gitlab-client-secret
# GITLAB_INSTANCE_URL=https://gitlab.com
# GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret

# --- Sentry webhook ---
# SENTRY_CLIENT_SECRET=your-sentry-webhook-signing-secret

# --- Claude Code auth for worker containers ---
# CLAUDE_CODE_OAUTH_TOKEN=your_oauth_token
# ANTHROPIC_API_KEY=sk-ant-your_key
# Model tier for this env-var override path (JEANCLODE_MODEL / JEANCLODE_SMALL_MODEL
# in the dispatched container). Optional — unset falls back to the CLI's own
# default (sonnet / haiku). Has no effect when using the DB llm_credentials pool,
# which carries its own model_high/model_low per row instead.
# CLAUDE_CODE_MODEL_HIGH=sonnet
# CLAUDE_CODE_MODEL_LOW=haiku
